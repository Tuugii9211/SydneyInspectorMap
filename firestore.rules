rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{report} {
      allow read: if true;
      // Only well-formed inspector reports, stamped with the server's time.
      allow create: if request.resource.data.keys().hasOnly(['location', 'timestamp', 'type'])
                    && request.resource.data.type == 'inspector'
                    && request.resource.data.location is latlng
                    && request.resource.data.timestamp == request.time;
      allow update, delete: if false; // Only cloud functions should delete
    }
  }
}
